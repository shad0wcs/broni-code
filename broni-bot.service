[Unit]
Description=BRONI_CODE Telegram notifier bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/broni-code
EnvironmentFile=/opt/broni-code/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/broni-code/venv/bin/python /opt/broni-code/app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
